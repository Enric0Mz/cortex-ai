{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean -fd*)",
      "Bash(git clean -fdx*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git restore --source*)",

      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -r *)",

      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm uninstall*)",
      "Bash(npm remove*)",
      "Bash(npm rm*)",

      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.test)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.test)",
      "Read(.env.local)",
      "Read(.env.test)"
    ]
  }
}
