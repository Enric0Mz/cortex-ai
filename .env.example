# Copy to .env.local and fill in.

# Supabase (Auth only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres
# Local dev: use the docker-compose Postgres (see docker-compose.yml).
# Production: point DATABASE_URL at Neon's pooled URL and DIRECT_URL at
# Neon's direct URL. Locally, both can be the same connection string
# since there is no pooler in front of the container.
DATABASE_URL=postgresql://cortex:cortex@localhost:5433/cortex_ai
DIRECT_URL=postgresql://cortex:cortex@localhost:5433/cortex_ai

# AI Providers (all free tiers for MVP)
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin
# Required to call POST /api/v1/admin/* routes via the x-admin-token header.
ADMIN_API_TOKEN=
