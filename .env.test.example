# Test environment — loaded by Playwright and Prisma test scripts.
# Contains no secrets; safe to commit.

# Test database (separate from dev DB, same local Postgres container).
DATABASE_URL=postgresql://cortex:cortex@localhost:5433/cortex_ai_test
DIRECT_URL=postgresql://cortex:cortex@localhost:5433/cortex_ai_test

# Supabase Auth — tests run against the same project as dev.
# Real values live in .env.local and are not duplicated here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — tests should never hit real provider APIs. The registry
# swaps to deterministic in-process fakes when USE_FAKE_PROVIDERS=true,
# so these keys can stay empty.
USE_FAKE_PROVIDERS=true
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3001

USE_FAKE_PROVIDERS=true

# Admin token used by admin-route integration tests.
ADMIN_API_TOKEN=test-admin-token
